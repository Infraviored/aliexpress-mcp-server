{
  "mcpServers": {
    "aliexpress": {
      "command": "/path/to/aliexpress-mcp-server/.venv/bin/python",
      "args": ["/path/to/aliexpress-mcp-server/aliexpress_mcp_server.py"],
      "env": {
        "ALIEXPRESS_CREDENTIALS": "~/.mcp-credentials/aliexpress.json",
        "ALIEXPRESS_COUNTRY": "DE",
        "ALIEXPRESS_CURRENCY": "EUR"
      }
    }
  }
}
